# Configurazione per l'esempio di monitoring datapizza-ai
# Copiare questo file in .env e configurare le variabili necessarie

# API Keys per i client AI
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Configurazione esportatori esterni (opzionale)
# Zipkin
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# OTLP per Jaeger/Grafana Tempo
OTLP_ENDPOINT=http://localhost:4317

# Configurazione Grafana (opzionale)
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=your_grafana_api_key_here

# Configurazione monitoring
SERVICE_NAME=datapizza-ai-monitoring-example
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
