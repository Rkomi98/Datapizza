# Configurazione Azure OpenAI (quello che hai già)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# Configurazione Azure Document Intelligence (servizio separato - opzionale)
# Se vuoi usare AzureParser avanzato, devi creare questo servizio separatamente
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_document_intelligence_key_here  
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-doc-intel-resource.cognitiveservices.azure.com/

# Altre configurazioni opzionali
OPENAI_API_KEY=your_openai_api_key_if_you_prefer_direct_openai
COHERE_API_KEY=your_cohere_api_key_for_reranking

# Qdrant (vector database)
QDRANT_HOST=localhost
QDRANT_PORT=6333
